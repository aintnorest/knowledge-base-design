{
  "config": {
    "default": true,
    // Index and log entries are one line each; tables cannot wrap.
    "MD013": false,
    // Dossiers repeat section names (Results, Limitations) under different parents.
    "MD024": { "siblings_only": true },
    // OKF frontmatter `title:` and a matching H1 are both house style.
    "MD025": { "front_matter_title": "" },
    // Log entries end with a bare canonical URL.
    "MD034": false,
    // Pipe spacing in tables is cosmetic; notes use `|---|` separators.
    "MD060": false
  },
  "ignores": ["archive/*/**", "archive/!(index).md", "inbox/**", ".worktrees/**", "node_modules/**"]
}
